@inbook{chap6_inca,
author = {CLEYNEN, Alice and DE SAPORTA, Benoîte and ROSSINI, Orlane and SABBADIN, Régis and VERNAY, Amélie},
publisher = {John Wiley & Sons, Ltd},
isbn = {9781394427581},
title = {Controlled Hidden Semi-Markov Models},
booktitle = {A Comprehensive Guide to HSMM},
chapter = {6},
pages = {185-230},
doi = {https://doi.org/10.1002/9781394427581.ch6},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781394427581.ch6},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781394427581.ch6},
year = {2025},
keywords = {continuous state spaces, discrete state spaces, HSMM, Markov decision processes, PDMP, semi-Markov dynamics},
abstract = {Summary This chapter discusses the controlled hidden semi-Markov models (HSMMs), and the objective is no longer to reconstruct hidden states or to estimate the model parameters but to design the best sequence of decisions in order to minimize some cost function depending on the whole trajectory of the process. In particular, the chapter considers that all model parameters are fully known. It provides the mathematical framework for sequential decision-making for fully observed Markov chains, called Markov decision processes (MDPs), in the simple case of discrete time and discrete state spaces. The chapter reviews the extensions of this basic model in the case of hidden information (or partially observed MDPs), and to the more general class of controlled hidden piecewise deterministic Markov processes (PDMPs) that encompasses both hidden information and Markov or semi-Markov dynamics in continuous time and in continuous state spaces.}
}

